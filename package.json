{
  "name": "hangman-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/mukta": "^0.4.1",
    "@expo-google-fonts/yatra-one": "^0.4.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "^15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "globals": "^16.5.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.13",
    "tsx": "4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint src scripts app.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "export:web": "expo export --platform web",
    "verify": "npm run verify:quick && npm run export:web",
    "verify:quick": "npm run lint && npm run typecheck && npm test -- --ci",
    "screenshots": "node scripts/screenshots.js",
    "words:check": "jest --ci src/data/words && node scripts/words-report.js",
    "port-scenes": "node scripts/port-scenes.js",
    "issue:brief": "node scripts/issue-brief.js",
    "words:sources": "node scripts/words-sources.js",
    "simulate:game": "tsx scripts/simulate-game.ts"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
